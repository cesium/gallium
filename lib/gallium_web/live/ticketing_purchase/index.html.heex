<div class="grow flex flex-col">
  <%= if !@purchase_blocked? do %>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 grow w-full py-8">
      <%= if @current_step < 4 do %>
        <.stepper
          current_step={@current_step}
          step_names={["Dados Pessoais", "Confirmar Bilhetes", "Pagamento", "Confirmação"]}
        />
      <% end %>
      <%= case @current_step do %>
        <% 1 -> %>
          <.personal_data form_data={@form_data} has_accompany?={@has_accompany?} />
        <% 2 -> %>
          <.buy_tickets
            form_data={@form_data}
            has_accompany?={@has_accompany?}
            amount_to_pay={@amount_to_pay}
            price_per_ticket={@price_per_ticket}
            companion_price={@companion_price}
          />
        <% 3 -> %>
          <.payment
            form_data={@form_data}
            has_accompany?={@has_accompany?}
            amount_to_pay={@amount_to_pay}
            price_per_ticket={@price_per_ticket}
            resuming_purchase?={@resuming_purchase?}
          />
        <% 4 -> %>
          <.confirmation
            form_data={@form_data}
            has_accompany?={@has_accompany?}
            amount_to_pay={@amount_to_pay}
            price_per_ticket={@price_per_ticket}
            current_scope={@current_scope}
            payment_status={@payment_status}
          />
      <% end %>
    </div>
  <% else %>
    <div class="flex-1 flex flex-col items-center justify-center py-20 px-4">
      <div class="text-center max-w-lg">
        <p class="text-bronze font-amarante text-5xl mb-6">✳</p>
        <h2 class="text-4xl font-amarante text-blue uppercase tracking-widest mb-3">
          Já não podes comprar
        </h2>
        <div class="w-12 h-0.5 bg-bronze mx-auto mb-6"></div>
        <p class="text-gray-500 text-xl font-cormorant leading-relaxed mb-10">
          <%= case @purchase_blocked_reason do %>
            <% :capacity -> %>
              Os bilhetes encontram-se esgotados.
            <% _ -> %>
              As vendas estão encerradas ou já possuis um bilhete associado à tua conta.
          <% end %>
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <.primary_button
            text="Voltar à Página Inicial"
            link={~p"/"}
            class="font-cormorant"
            color={:blue}
          />
          <.primary_button
            text="Ver o meu Perfil"
            link={~p"/user/profile"}
            class="font-cormorant"
            color={:blue}
          />
        </div>
      </div>
    </div>
  <% end %>
</div>
