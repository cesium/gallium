<.app flash={@flash} current_scope={@current_scope}>
  <div class="flex flex-col gap-8 items-center px-4 py-16 w-full max-w-5xl mx-auto">
    <div class="text-center mb-4">
      <p class="text-bronze font-cormorant text-sm tracking-[3px] uppercase mb-3">
        Disponibilidade Limitada
      </p>
      <h2 class="text-bronze font-amarante text-6xl uppercase mb-4">
        Bilhetes
      </h2>
      <p class="text-gray-500 font-cormorant text-xl">
        Escolhe a opção que melhor se adequa a ti
      </p>
    </div>

    <.ticket
      title="SÓCIO CESIUM"
      subtitle="Preço exclusivo para sócios CeSIUM"
      price="30"
      link={~p"/tickets/buy?type=socio"}
      advantages_list={[
        "Jantar completo",
        "Sessão fotográfica",
        "Transporte opcional",
        "Animação e karaoke"
      ]}
    />

    <.ticket
      title="NÃO SÓCIO"
      subtitle="Aberto a todos os estudantes"
      price="33"
      link={~p"/tickets/buy?type=nao_socio"}
      advantages_list={[
        "Jantar completo",
        "Sessão fotográfica",
        "Transporte opcional",
        "Animação e karaoke"
      ]}
    />
  </div>
</.app>
