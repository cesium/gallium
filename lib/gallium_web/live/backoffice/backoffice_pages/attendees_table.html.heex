<div class="flex flex-col gap-6">

  <%# Stats cards %>
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="bg-white rounded-xl border border-gray-200 px-5 py-4 shadow-sm">
      <p class="text-xs font-cormorant uppercase tracking-widest text-gray-400 mb-1">Total</p>
      <p class="text-3xl font-amarante text-olive">{length(@attendees)}</p>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 px-5 py-4 shadow-sm">
      <p class="text-xs font-cormorant uppercase tracking-widest text-gray-400 mb-1">Pagos</p>
      <p class="text-3xl font-amarante text-green-600">
        {@attendees |> Enum.count(&(&1.payment && &1.payment.status == :paid))}
      </p>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 px-5 py-4 shadow-sm">
      <p class="text-xs font-cormorant uppercase tracking-widest text-gray-400 mb-1">Sócios</p>
      <p class="text-3xl font-amarante text-olive">
        {@attendees |> Enum.count(&(&1.user.ticket && &1.user.ticket.type == :member))}
      </p>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 px-5 py-4 shadow-sm">
      <p class="text-xs font-cormorant uppercase tracking-widest text-gray-400 mb-1">Com Acomp.</p>
      <p class="text-3xl font-amarante text-blue">
        {@attendees |> Enum.count(& &1.accompany)}
      </p>
    </div>
  </div>

  <%# Table %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-100">
      <h2 class="text-xl font-amarante text-gray-800 uppercase tracking-wide">Inscrições</h2>
    </div>

    <%= if @attendees == [] do %>
      <div class="flex flex-col items-center justify-center py-24 text-gray-300 font-cormorant">
        <.icon name="hero-users" class="size-14 mb-4" />
        <p class="text-lg">Ainda não há inscrições.</p>
      </div>
    <% else %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm font-cormorant">
          <thead>
            <tr class="bg-gray-50 border-b border-gray-200 text-xs uppercase tracking-widest text-gray-500">
              <th class="px-5 py-3 text-left font-semibold">Nome</th>
              <th class="px-5 py-3 text-left font-semibold">Nº Aluno</th>
              <th class="px-5 py-3 text-center font-semibold">Bilhete</th>
              <th class="px-5 py-3 text-left font-semibold">Acompanhante</th>
              <th class="px-5 py-3 text-center font-semibold">Transporte</th>
              <th class="px-5 py-3 text-left font-semibold">Mesa</th>
              <th class="px-5 py-3 text-left font-semibold">Alergias</th>
              <th class="px-5 py-3 text-center font-semibold">Pagamento</th>
              <th class="px-5 py-3 text-right font-semibold">Valor</th>
              <th class="px-5 py-3 text-right font-semibold">Data</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <%= for attendee <- @attendees do %>
              <tr class="hover:bg-gray-50/60 transition-colors">
                <td class="px-5 py-3.5 font-medium text-gray-800">
                  {attendee.full_name}
                </td>
                <td class="px-5 py-3.5 text-gray-400 font-mono text-xs">
                  {attendee.student_number || "—"}
                </td>
                <td class="px-5 py-3.5 text-center">
                  <%= case attendee.user.ticket && attendee.user.ticket.type do %>
                    <% :member -> %>
                      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs bg-olive-100 text-olive-700 font-semibold border border-olive-200">
                        <.icon name="hero-academic-cap" class="size-3" /> Sócio
                      </span>
                    <% :non_member -> %>
                      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs bg-gray-100 text-gray-500 font-semibold border border-gray-200">
                        <.icon name="hero-user" class="size-3" /> Não Sócio
                      </span>
                    <% _ -> %>
                      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs bg-gray-100 text-gray-300 font-semibold border border-gray-200">
                        —
                      </span>
                  <% end %>
                </td>
                <td class="px-5 py-3.5">
                  <%= if attendee.accompany do %>
                    <div class="flex flex-col">
                      <span class="text-gray-800 font-medium">{attendee.accompany.full_name}</span>
                      <span class="text-gray-400 text-xs">{attendee.accompany.email}</span>
                    </div>
                  <% else %>
                    <span class="text-gray-300">—</span>
                  <% end %>
                </td>
                <td class="px-5 py-3.5 text-center">
                  <%= if attendee.wants_transport do %>
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs bg-blue-50 text-blue-700 font-semibold border border-blue-200">
                      <.icon name="hero-check" class="size-3" /> Sim
                    </span>
                  <% else %>
                    <span class="text-gray-300">—</span>
                  <% end %>
                </td>
                <td class="px-5 py-3.5 text-gray-600">
                  <%= if attendee.table_preference && attendee.table_preference != "" do %>
                    {attendee.table_preference}
                  <% else %>
                    <span class="text-gray-300">—</span>
                  <% end %>
                </td>
                <td class="px-5 py-3.5 text-gray-600">
                  <%= if attendee.allergies && attendee.allergies != "" do %>
                    {attendee.allergies}
                  <% else %>
                    <span class="text-gray-300">—</span>
                  <% end %>
                </td>
                <td class="px-5 py-3.5 text-center">
                  <%= case attendee.payment do %>
                    <% nil -> %>
                      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs bg-gray-100 text-gray-400 font-semibold border border-gray-200">
                        Sem pagamento
                      </span>
                    <% %{status: :paid} -> %>
                      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs bg-green-50 text-green-700 font-semibold border border-green-200">
                        <.icon name="hero-check" class="size-3" /> Pago
                      </span>
                    <% %{status: :pending} -> %>
                      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs bg-yellow-50 text-yellow-700 font-semibold border border-yellow-200">
                        <.icon name="hero-clock" class="size-3" /> Pendente
                      </span>
                    <% %{status: :failed} -> %>
                      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs bg-red-50 text-red-600 font-semibold border border-red-200">
                        <.icon name="hero-x-mark" class="size-3" /> Falhado
                      </span>
                    <% _ -> %>
                      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs bg-gray-100 text-gray-400 font-semibold border border-gray-200">
                        Desconhecido
                      </span>
                  <% end %>
                </td>
                <td class="px-5 py-3.5 text-right font-medium text-gray-700">
                  <%= if attendee.payment do %>
                    {attendee.payment.amount}€
                  <% else %>
                    <span class="text-gray-300">—</span>
                  <% end %>
                </td>
                <td class="px-5 py-3.5 text-right text-gray-400 text-xs whitespace-nowrap">
                  {Calendar.strftime(attendee.inserted_at, "%d/%m/%Y")}
                  <br />
                  <span class="text-gray-300">{Calendar.strftime(attendee.inserted_at, "%H:%M")}</span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>
